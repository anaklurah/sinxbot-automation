# ============================================================
# OSAP Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
OSAP_DB_PATH=./osap.db

# --- Directory Paths ---
DOWNLOAD_DIR=./downloads
ASSETS_DIR=./assets
PROFILES_DIR=./assets/profiles

# --- DeepSeek AI (Required for caption generation) ---
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# Platform Toggles (set to false to disable a platform)
# ============================================================
PLATFORM_YOUTUBE=true
PLATFORM_FACEBOOK=true
PLATFORM_INSTAGRAM=true
PLATFORM_TWITTER=true
PLATFORM_TWITTER_NSF=false
PLATFORM_TIKTOK=true
PLATFORM_UPSCROLLED=false
PLATFORM_FEBSPOT=false

# ============================================================
# Proxy (Optional — for VPS/datacenter IP evasion)
# Leave empty if not needed.
# Format: socks5://user:pass@host:port  or  http://host:port
# ============================================================
PROXY_URL=

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=./osap.log
